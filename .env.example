# Copy these names into Vercel → Project → Settings → Environment Variables
# Never commit real keys. .gitignore already blocks .env*

# Project URL (no /rest/v1 at the end)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (anon) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Secret key — SERVER ONLY (API routes / server components). Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- XixaPay (user wallet funding — dynamic virtual accounts) ---
XIXAPAY_API_KEY=
XIXAPAY_SECRET_KEY=
XIXAPAY_BUSINESS_ID=
XIXAPAY_BASE_URL=https://api.xixapay.com
XIXAPAY_VIRTUAL_ACCOUNT_WEBHOOK_URL=https://vernexdigital.com/api/webhooks/xixapay/virtual-account

# --- Verxor parent API (SMM boost wholesale) ---
# Always use www — apex can 308 and drop POST bodies
VERXOR_API_BASE=https://www.verxor.com/api/v1
VERXOR_PANEL_API_KEY=vx_panel_...
# Optional: end-user markup on partner cost (default 0.25 = +25%)
BOOST_PANEL_MARKUP=0.25
